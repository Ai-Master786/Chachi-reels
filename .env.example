# ==============================================================================
# SOCIAL VAULT 2.0 — Environment Configuration
# ==============================================================================
# NO environment variables are required to run locally or deploy on Vercel.
# Deploy straight from GitHub -> Vercel with zero setup.
# ==============================================================================

# OPTIONAL: Canonical site URL used in /sitemap.xml and /robots.txt.
# On Vercel this is detected automatically from VERCEL_PROJECT_PRODUCTION_URL
# or VERCEL_URL, so you only need to set this if you want a manual override
# (for example: https://socialvault.yourdomain.com).
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
